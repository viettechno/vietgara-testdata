{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/viettechno/vietgara-testdata/schema/dataset.schema.json",
  "title": "VietGara test dataset (merged data/*.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "emailDomain", "environments", "plans", "users", "garages", "staff", "customers", "suppliers"],
  "properties": {
    "version": { "const": 1 },
    "emailDomain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.test$", "description": "Reserved test domain; never a real mail domain" },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "password": { "type": "string", "minLength": 8 },
          "adminPassword": { "type": "string", "minLength": 8 },
          "passwordRef": { "$ref": "#/$defs/envName" },
          "adminPasswordRef": { "$ref": "#/$defs/envName" }
        },
        "oneOf": [
          { "required": ["password", "adminPassword"], "not": { "anyOf": [{ "required": ["passwordRef"] }, { "required": ["adminPasswordRef"] }] } },
          { "required": ["passwordRef", "adminPasswordRef"], "not": { "anyOf": [{ "required": ["password"] }, { "required": ["adminPassword"] }] } }
        ]
      }
    },
    "plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } },
    "users": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/user" } },
    "garages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/garage" } },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "staff": { "type": "array", "items": { "$ref": "#/$defs/staff" } },
    "customers": { "type": "array", "items": { "$ref": "#/$defs/customer" } },
    "suppliers": { "type": "array", "items": { "$ref": "#/$defs/supplier" } },
    "catalogue": { "$ref": "#/$defs/catalogue" }
  },
  "$defs": {
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "requires": { "type": "string", "pattern": "^phase-[0-9]+$" },
    "phone": { "type": "string", "pattern": "^0[0-9]{9,10}$" },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "price", "currency", "billingCycle", "limits"],
      "properties": {
        "code": { "type": "string", "pattern": "^qa-[a-z0-9-]+$" },
        "name": { "type": "string" },
        "price": { "type": "integer", "minimum": 0 },
        "currency": { "const": "VND" },
        "billingCycle": { "enum": ["monthly", "yearly"] },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["maxGarages", "maxStaff", "maxTransactionsPerDay"],
          "properties": {
            "maxGarages": { "type": "integer", "minimum": 1 },
            "maxStaff": { "type": "integer", "minimum": 1 },
            "maxTransactionsPerDay": { "type": "integer", "minimum": 1 }
          }
        },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "user": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "phone": { "$ref": "#/$defs/phone" },
        "plan": { "type": "string", "description": "Plan of an owner: a built-in plan code or a plan of this dataset" },
        "platformAdmin": { "type": "boolean" },
        "platformRole": { "$ref": "#/$defs/key" },
        "supplierFor": { "type": "string", "pattern": "^supplier[0-9]+-[0-9]+-[0-9]+$", "description": "Supplier this user is linked to (supplier portal, Phase 17)" },
        "verified": { "type": "boolean" },
        "requires": { "$ref": "#/$defs/requires" },
        "note": { "type": "string" }
      }
    },
    "garage": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "owner", "name"],
      "properties": {
        "key": { "type": "string", "pattern": "^gara[0-9]+-[0-9]+$" },
        "owner": { "$ref": "#/$defs/key" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "taxCode": { "type": "string", "pattern": "^[0-9]{10}(-[0-9]{3})?$" }
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "name", "permissions"],
      "properties": {
        "owner": { "$ref": "#/$defs/key" },
        "name": { "type": "string" },
        "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_.]+$" } }
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["garage", "name", "role"],
      "properties": { "garage": { "type": "string" }, "name": { "type": "string" }, "role": { "type": "string" } }
    },
    "staff": {
      "type": "object", "additionalProperties": false,
      "required": ["user", "garage", "group"],
      "properties": { "user": { "$ref": "#/$defs/key" }, "garage": { "type": "string" }, "group": { "type": "string" } }
    },
    "customer": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "garage", "name"],
      "properties": {
        "key": { "type": "string", "pattern": "^customer[0-9]+-[0-9]+-[0-9]+$" },
        "garage": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "$ref": "#/$defs/phone" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[a-z0-9.-]+\\.test$" },
        "consent": { "type": "boolean" },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["plate", "make", "model", "year"],
            "properties": {
              "plate": { "type": "string", "pattern": "^[0-9]{2}[A-Z]-[0-9]{3}\\.[0-9]{2}$" },
              "make": { "type": "string" }, "model": { "type": "string" },
              "year": { "type": "integer", "minimum": 1980, "maximum": 2100 }
            }
          }
        }
      }
    },
    "supplier": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "garage", "name"],
      "properties": {
        "key": { "type": "string", "pattern": "^supplier[0-9]+-[0-9]+-[0-9]+$" },
        "garage": { "type": "string" },
        "name": { "type": "string" },
        "taxCode": { "type": "string", "pattern": "^[0-9]{10}(-[0-9]{3})?$" },
        "contact": {
          "type": "object", "additionalProperties": false,
          "properties": { "person": { "type": "string" }, "phone": { "$ref": "#/$defs/phone" }, "email": { "type": "string", "pattern": "^[^@\\s]+@[a-z0-9.-]+\\.test$" } }
        }
      }
    },
    "catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["garage", "units", "items"],
      "properties": {
        "requires": { "$ref": "#/$defs/requires" },
        "garage": { "type": "string" },
        "units": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "additionalProperties": false, "required": ["key", "name", "abbreviation"], "properties": { "key": { "$ref": "#/$defs/key" }, "name": { "type": "string" }, "abbreviation": { "type": "string" } } }
        },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sku", "name", "baseUnit"],
            "properties": {
              "sku": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
              "name": { "type": "string" },
              "category": { "$ref": "#/$defs/key" },
              "brand": { "type": "string" },
              "baseUnit": { "$ref": "#/$defs/key" },
              "packaging": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": false, "required": ["unit", "factor"], "properties": { "unit": { "$ref": "#/$defs/key" }, "factor": { "type": "number", "exclusiveMinimum": 0 } } }
              },
              "reorderThreshold": { "type": "integer", "minimum": 0 },
              "defaultSupplier": { "type": "string" }
            }
          }
        }
      }
    },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name"],
      "properties": { "key": { "$ref": "#/$defs/key" }, "name": { "type": "string" }, "children": { "type": "array", "items": { "$ref": "#/$defs/category" } } }
    }
  }
}
